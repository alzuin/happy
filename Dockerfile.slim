# Standalone happy-server — slim build using pnpm deploy.
#
# pnpm deploy creates an isolated /deploy with only happy-server's own deps
# (~500 MB vs 4.6 GB for the full workspace node_modules). Full workspace
# install is required in intermediate stages so deploy can resolve everything,
# but those layers are discarded; only /deploy reaches the final image.
#
# Final image: ~950 MB (node:20-slim + ffmpeg + /deploy).

# Stage 1: full workspace install (intermediate — not in final image)
FROM node:20 AS deps

RUN apt-get update && apt-get install -y python3 make g++ build-essential && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
COPY patches ./patches

RUN mkdir -p packages/happy-app packages/happy-server packages/happy-cli packages/happy-agent packages/happy-wire packages/happy-server-self-host

COPY packages/happy-app/package.json packages/happy-app/
COPY packages/happy-server/package.json packages/happy-server/
COPY packages/happy-cli/package.json packages/happy-cli/
COPY packages/happy-agent/package.json packages/happy-agent/
COPY packages/happy-wire/package.json packages/happy-wire/
COPY packages/happy-server-self-host/package.json packages/happy-server-self-host/

COPY packages/happy-app/patches packages/happy-app/patches
COPY packages/happy-server/prisma packages/happy-server/prisma
COPY packages/happy-cli/scripts packages/happy-cli/scripts
COPY packages/happy-cli/tools packages/happy-cli/tools
# postinstall requirement: this package's own postinstall.cjs runs at install
# time and exits gracefully if prisma/schema.prisma isn't there yet (it never
# is in a fresh checkout — that file is a build artifact), but the script
# itself must exist for pnpm to invoke it.
COPY packages/happy-server-self-host/scripts packages/happy-server-self-host/scripts

RUN SKIP_HAPPY_WIRE_BUILD=1 pnpm install --frozen-lockfile

# Stage 2: build happy-wire and create isolated deployment
FROM deps AS builder

COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-server ./packages/happy-server
COPY packages/happy-server-self-host ./packages/happy-server-self-host

# Build happy-wire so its dist/ is available when deploy bundles it.
RUN pnpm --filter @slopus/happy-wire build

# pnpm v10 requires --legacy for non-injected workspace deploys.
# Deploy runs happy-server's postinstall (prisma generate) automatically.
# tsx (devDep) is included because --prod is not set.
RUN pnpm --filter happy-server-self-host deploy --legacy /deploy

# sources/ is excluded by the package's `files` array (publishable list).
# Copy it manually — the CMD uses tsx to run TypeScript directly from source.
RUN cp -r packages/happy-server/sources /deploy/sources

RUN cp packages/happy-server/tsconfig.json /deploy/tsconfig.json

# prisma/ is a build artifact of happy-server-self-host (normally produced by
# build-runtime.cjs, which we skip since it shells out to bun). standalone.ts
# resolves prisma/migrations relative to process.cwd(), so it must physically
# exist at /deploy/prisma, not just be on the Prisma Client's generator path.
RUN cp -r packages/happy-server/prisma /deploy/prisma

RUN cd /deploy && PATH="/deploy/node_modules/.bin:$PATH" \
    ./node_modules/.bin/prisma generate --schema prisma/schema.prisma

# Patch pglite-prisma-adapter Bytes handling in the isolated /deploy.
# The workspace postinstall.cjs patched /repo/node_modules; /deploy has its
# own isolated copy that needs the same fix.
RUN node -e 'var fs=require("fs");["/deploy/node_modules/pglite-prisma-adapter/dist/index.mjs","/deploy/node_modules/pglite-prisma-adapter/dist/index.cjs"].forEach(function(f){if(!fs.existsSync(f))return;var c=fs.readFileSync(f,"utf8");var d=c.replace(/Uint8Array\.from\(\s*\{\s*length:\s*hexString\.length\s*\/\s*2\s*\}/g,"Array.from({ length: hexString.length / 2 }");if(d!==c){fs.writeFileSync(f,d);console.log("[patch] "+f);}});'

# Stage 3: minimal runtime — only the deploy output
FROM node:20-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y ffmpeg curl && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV DATA_DIR=/data
ENV PGLITE_DIR=/data/pglite

COPY --from=builder /deploy /app

VOLUME /data
EXPOSE 3005

CMD ["sh", "-c", "node_modules/.bin/tsx sources/standalone.ts migrate && exec node_modules/.bin/tsx sources/standalone.ts serve"]
